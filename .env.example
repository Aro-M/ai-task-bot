# Copy to .env; replace every REPLACE value before starting. Never commit .env.
# Local Docker: generate three independent secrets with openssl rand -hex 32.
ENVIRONMENT=development
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://taskbot:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@postgres:5432/taskbot
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# Required for the default paid mode; ChatGPT subscription is separate from API billing.
OPENAI_API_KEY=
TASK_PARSER_ENABLED=true
TASK_PARSER_MODEL=gpt-6-luna
TASK_PARSER_TIMEOUT_SEC=15
FRONTEND_ORIGIN=http://localhost:8080
WHISPER_MODEL=gpt-transcribe
WHISPER_LANGUAGE=auto
MAX_AUDIO_DURATION_SEC=120
MAX_AUDIO_FILE_SIZE_MB=20
TRANSCRIPTION_JOB_TIMEOUT_SEC=60
# Per-user admission counts, not dollar caps. Daily resets at UTC midnight.
DAILY_TRANSCRIPTION_LIMIT_PER_USER=500
HOURLY_TRANSCRIPTION_LIMIT=500
MAX_CONCURRENT_JOBS_PER_USER=2
GLOBAL_QUEUED_JOBS_LIMIT=1000
GLOBAL_AI_REQUESTS_PER_MINUTE=30
WHISPER_COST_PER_MINUTE=0.0045

MIN_AUDIO_DURATION_SEC=1
WHISPER_TIMEOUT_SEC=45
WHISPER_MAX_RETRIES=3
WHISPER_RETRY_BACKOFF_BASE=2
WHISPER_RETRY_BACKOFF_MAX=30
WORKER_CONCURRENCY=4

# Free local speech: leave OPENAI_API_KEY empty here and use make up-local-ai.
# The overlay selects a local-only key/endpoint and disables the generative parser.
# It does not modify this file and cannot be used with ENVIRONMENT=production.
